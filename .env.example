# file (default) uses a deterministic local calendar. No OAuth required.
CALENDAR_PROVIDER=file

# Optional Google Calendar adapter (stubbed — interface only for this MVP)
# CALENDAR_PROVIDER=google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=

# SQLite location. Defaults to ./data locally and /tmp/inherit on Vercel.
# INHERIT_DATA_DIR=./data

SLOT_CAPACITY=3
STUDIO_TIMEZONE=America/Los_Angeles
